# Copy to .env and fill in. Not needed for: python main.py --offline
ANTHROPIC_API_KEY=your-key-here
# Any LiteLLM/CrewAI model string, e.g. openai/gpt-4o-mini (then set OPENAI_API_KEY)
CREW_MODEL=anthropic/claude-sonnet-4-5
CREWAI_TRACING_ENABLED=false

# Only if the API key is not scoped to a workspace (Anthropic returns a 400 asking for this header)
# ANTHROPIC_WORKSPACE_ID=
