diff --git a/app/src/modules/environment/EnvironmentModel.tsx b/app/src/modules/environment/EnvironmentModel.tsx
new file mode 100644
index 0000000..f0b2b62
--- /dev/null
+++ b/app/src/modules/environment/EnvironmentModel.tsx
@@ -0,0 +1,122 @@
+import { useEffect, useMemo } from 'react'
+import { RigidBody } from '@react-three/rapier'
+import { useGLTF } from '@react-three/drei'
+import * as THREE from 'three'
+import type { EnvironmentModelConfig } from '../../types/world'
+
+interface Props {
+  config: EnvironmentModelConfig
+}
+
+const ignoreRaycast: THREE.Object3D['raycast'] = () => {}
+const COLLIDER_ONLY_LAYER = 30
+
+function placementMatrix(config: EnvironmentModelConfig) {
+  return new THREE.Matrix4().compose(
+    new THREE.Vector3(...config.position),
+    new THREE.Quaternion().setFromEuler(new THREE.Euler(...config.rotation)),
+    new THREE.Vector3(config.scale, config.scale, config.scale),
+  )
+}
+
+// Textured mesh as the static environment (replaces the splat), with a separate
+// low-poly mesh used only for trimesh physics.
+//
+// The collider's placement is baked into its vertices and the RigidBody stays at the
+// identity transform, so physics never depends on RigidBody/collider scale handling.
+export function EnvironmentModel({ config }: Props) {
+  const { scene: visualRaw } = useGLTF(config.url)
+  const { scene: colliderRaw } = useGLTF(config.colliderUrl)
+
+  const matrixKey = `${config.position.join(',')}:${config.rotation.join(',')}:${config.scale}`
+
+  const visual = useMemo(() => {
+    const clone = visualRaw.clone(true)
+    clone.traverse((child) => {
+      if (!(child instanceof THREE.Mesh)) return
+      child.raycast = ignoreRaycast
+      child.frustumCulled = false
+    })
+    return clone
+  }, [visualRaw])
+
+  const collider = useMemo(() => {
+    const root = new THREE.Group()
+    const placement = placementMatrix(config)
+    colliderRaw.updateWorldMatrix(true, true)
+    colliderRaw.traverse((child) => {
+      if (!(child instanceof THREE.Mesh)) return
+      const geometry = child.geometry.clone()
+      geometry.applyMatrix4(placement.clone().multiply(child.matrixWorld))
+      const mesh = new THREE.Mesh(geometry)
+      // Must stay `visible` or rapier's auto-collider skips it; a layer the camera never renders keeps it off-screen.
+      mesh.layers.set(COLLIDER_ONLY_LAYER)
+      mesh.raycast = ignoreRaycast
+      root.add(mesh)
+    })
+    return root
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, [colliderRaw, matrixKey])
+
+  useEffect(() => () => {
+    collider.traverse((child) => {
+      if (child instanceof THREE.Mesh) child.geometry.dispose()
+    })
+  }, [collider])
+
+  const scale: [number, number, number] = [config.scale, config.scale, config.scale]
+
+  return (
+    <>
+      <RigidBody key={`${config.colliderUrl}:${matrixKey}`} type="fixed" colliders="trimesh">
+        <primitive object={collider} />
+      </RigidBody>
+      <primitive object={visual} position={config.position} rotation={config.rotation} scale={scale} />
+      {config.seaUrl && <Sea url={config.seaUrl} level={config.seaLevel ?? 0} />}
+      {config.extraModels?.map((extra) => (
+        <ExtraModel key={extra.id} url={extra.url} solid={extra.solid ?? true} invisible={extra.invisible ?? false} />
+      ))}
+    </>
+  )
+}
+
+// A static model authored directly in world coordinates (no placement transform). Visual and
+// trimesh collider are the same mesh, so keep these low-poly (gangway, gate, ...).
+// `solid: false` keeps the visual but removes collision (e.g. an unlocked gate).
+// `invisible: true` keeps collision but never renders it (e.g. barriers).
+function ExtraModel({ url, solid, invisible }: { url: string; solid: boolean; invisible: boolean }) {
+  const { scene: raw } = useGLTF(url)
+  const model = useMemo(() => {
+    const clone = raw.clone(true)
+    clone.traverse((child) => {
+      if (!(child instanceof THREE.Mesh)) return
+      child.raycast = ignoreRaycast
+      if (invisible) child.layers.set(COLLIDER_ONLY_LAYER)
+    })
+    return clone
+  }, [raw, invisible])
+  if (!solid) return <primitive object={model} />
+  return (
+    <RigidBody key={url} type="fixed" colliders="trimesh">
+      <primitive object={model} />
+    </RigidBody>
+  )
+}
+
+// Flat, high-resolution sea grid (see environment/1-sea.glb). It has no collider.
+// Animate waves later by displacing its vertices here (e.g. in useFrame or a shader patch).
+function Sea({ url, level }: { url: string; level: number }) {
+  const { scene: raw } = useGLTF(url)
+  const sea = useMemo(() => {
+    const clone = raw.clone(true)
+    clone.traverse((child) => {
+      if (!(child instanceof THREE.Mesh)) return
+      child.raycast = ignoreRaycast
+      child.frustumCulled = false
+      const materials = Array.isArray(child.material) ? child.material : [child.material]
+      for (const material of materials) material.side = THREE.DoubleSide
+    })
+    return clone
+  }, [raw])
+  return <primitive object={sea} position={[0, level, 0]} />
+}
